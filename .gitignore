# Binaries
/bin/
/dist/
*.exe
*.test
*.out

# Prebuilt cross-compiled binaries are tracked under release/.
# Counteract the /*.exe rule above for files inside release/.
!/release/
!/release/*.exe

# Go
/vendor/
*.prof

# Editors
.vscode/
.idea/
*.swp
.DS_Store

# Local config
*.local.yaml
*.local.toml
.env
